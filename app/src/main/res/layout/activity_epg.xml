<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:paddingBottom="46dp">

        <!-- Meni agoch (parèt lè kliyan an peze BACK oswa ◀ de fwa) -->
        <LinearLayout android:id="@+id/menu" android:layout_width="200dp" android:layout_height="match_parent"
            android:background="#0C0C0E" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="14dp" android:paddingBottom="10dp" android:visibility="gone">
            <ImageView android:id="@+id/menuLogo" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_marginBottom="12dp"
                android:adjustViewBounds="true" android:scaleType="fitStart" android:src="@drawable/logo_full" android:importantForAccessibility="no"/>
            <LinearLayout android:id="@+id/menuItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/menuSearch" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_menu_item" android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:singleLine="true" android:textColor="@color/menu_text" android:textSize="17sp"
                    android:tag="s" android:text="@string/menu_search" android:nextFocusUp="@id/menuSearch"/>
                <TextView android:id="@+id/menuTv" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_menu_item" android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:singleLine="true" android:textColor="@color/menu_text" android:textSize="17sp"
                    android:tag="t" android:text="@string/menu_tv"/>
                <TextView android:id="@+id/menuMovies" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_menu_item" android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:singleLine="true" android:textColor="@color/menu_text" android:textSize="17sp"
                    android:tag="m" android:text="@string/home_movies"/>
                <TextView android:id="@+id/menuSeries" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_menu_item" android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:singleLine="true" android:textColor="@color/menu_text" android:textSize="17sp"
                    android:tag="e" android:text="@string/home_series"/>
                <TextView android:id="@+id/menuFav" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_menu_item" android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:singleLine="true" android:textColor="@color/menu_text" android:textSize="17sp"
                    android:tag="f" android:text="@string/menu_favorites"/>
                <TextView android:id="@+id/menuCatchup" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_menu_item" android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:singleLine="true" android:textColor="@color/menu_text" android:textSize="17sp"
                    android:tag="c" android:text="@string/menu_catchup"/>
                <TextView android:id="@+id/menuSettings" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_menu_item" android:clickable="true" android:focusable="true" android:gravity="center_vertical"
                    android:singleLine="true" android:textColor="@color/menu_text" android:textSize="17sp"
                    android:tag="g" android:text="@string/home_settings" android:nextFocusDown="@id/menuSettings"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <LinearLayout android:id="@+id/accBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/accName" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp"
                android:singleLine="true" android:ellipsize="end" android:textColor="@color/text" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/accPlan" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp"
                android:singleLine="true" android:textColor="@color/text_dim" android:textSize="11sp"/>
            <TextView android:id="@+id/accExp" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10dp"
                android:singleLine="true" android:textColor="@color/text_dim" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Kategori (parèt lè kliyan an peze ◀ nan kòmansman yon ranje) -->
        <LinearLayout android:id="@+id/catPanel" android:layout_width="214dp" android:layout_height="match_parent" android:orientation="vertical"
            android:background="#18181B" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="14dp" android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/categories" android:layout_width="match_parent"
                android:layout_height="match_parent" android:descendantFocusability="afterDescendants"/>
        </LinearLayout>

        <!-- Apèsi videyo + enfo, epi griy pwogram yo -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="158dp" android:orientation="horizontal">
                <FrameLayout android:layout_width="281dp" android:layout_height="158dp" android:background="@android:color/black">
                    <androidx.media3.ui.PlayerView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:focusable="false"
                        app:use_controller="false" app:resize_mode="fit" app:surface_type="surface_view" app:shutter_background_color="@android:color/black"/>
                    <ImageView android:id="@+id/previewLogo" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@color/bg_panel" android:padding="44dp" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginStart="14dp" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:id="@+id/detailChannel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:singleLine="true" android:ellipsize="end" android:textColor="@color/accent2" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/detailTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end"
                        android:textColor="@color/text" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/detailTime" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textColor="@color/text_dim" android:textSize="13sp"/>
                    <TextView android:id="@+id/detailDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:maxLines="3" android:ellipsize="end" android:textColor="#DDFFFFFF" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Liy lè yo -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="8dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/dayLabel" android:layout_width="184dp" android:layout_height="wrap_content"
                    android:textColor="@color/accent2" android:textSize="13sp" android:textStyle="bold"/>
                <LinearLayout android:id="@+id/timeHeader" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:orientation="horizontal"/>
            </LinearLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rows" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:descendantFocusability="afterDescendants"/>
                <View android:id="@+id/nowLine" android:layout_width="2dp" android:layout_height="match_parent"
                    android:background="#DDFFFFFF" android:visibility="gone"/>
                <ProgressBar android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"/>
                <TextView android:id="@+id/message" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:textColor="@color/text_dim" android:textSize="15sp" android:visibility="gone"/>
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

    <include android:id="@+id/overlay" layout="@layout/overlay_panel"/>
</FrameLayout>
