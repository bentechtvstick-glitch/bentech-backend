<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp"
    android:background="@drawable/bg_focus" android:focusable="true" android:clickable="true"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp">
    <FrameLayout android:layout_width="128dp" android:layout_height="72dp">
        <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@color/bg_panel" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
        <ProgressBar android:id="@+id/watched" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent"
            android:layout_height="4dp" android:layout_gravity="bottom" android:max="100" android:progressDrawable="@drawable/progress_epg" android:visibility="gone"/>
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/plot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:maxLines="2" android:ellipsize="end" android:textColor="@color/text_dim" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:textColor="@color/text_dim" android:textSize="12sp"/>
</LinearLayout>
