<?xml version="1.0" encoding="utf-8"?>
<!-- Ekran akèy la: gwo kat "TV an dirèk", gid chanèl, fim, seri, timoun, reglaj -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_home">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="30dp" android:paddingEnd="30dp" android:paddingTop="20dp" android:paddingBottom="48dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name"
                    android:textColor="#111827" android:textSize="28sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_tagline"
                    android:textColor="#4B5563" android:textSize="15sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
                <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#111827" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#4B5563" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/hero" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.7"
                android:background="@drawable/bg_home_hero" android:clickable="true" android:focusable="true"
                android:paddingStart="30dp" android:paddingEnd="34dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08"
                        android:text="@string/home_live_label" android:textColor="#CFE3FF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:maxWidth="400dp" android:text="@string/home_watch_title" android:textColor="#FFFFFF" android:textSize="27sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/heroSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:maxWidth="400dp" android:singleLine="true" android:ellipsize="end" android:textColor="#DCE8FF" android:textSize="15sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:background="@drawable/bg_home_pill" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="9dp" android:paddingBottom="9dp"
                        android:text="@string/home_watch_now" android:textColor="#0B2FA8" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical"
                    android:gravity="center_horizontal" android:orientation="vertical" android:importantForAccessibility="no">
                    <FrameLayout android:layout_width="150dp" android:layout_height="96dp" android:background="@drawable/bg_home_tvframe">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                            android:background="@drawable/bg_home_live" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                            android:text="LIVE" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
                    </FrameLayout>
                    <View android:layout_width="6dp" android:layout_height="12dp" android:background="#BBD9FF"/>
                    <View android:layout_width="64dp" android:layout_height="5dp" android:background="#BBD9FF"/>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout android:id="@+id/tileGuide" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="14dp" android:background="@drawable/bg_home_tile" android:clickable="true" android:focusable="true"
                android:orientation="vertical" android:padding="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_guide_title"
                    android:textColor="#111827" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_guide_sub"
                    android:textColor="#6B7280" android:textSize="14sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
                    android:text="📺" android:textSize="54sp" android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="92dp" android:layout_marginTop="14dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/tileMovies" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/bg_home_tile" android:clickable="true" android:focusable="true"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true"
                        android:text="@string/home_movies" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true"
                        android:text="@string/home_movies_sub" android:textColor="#6B7280" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎬" android:textSize="30sp"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tileSeries" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="14dp" android:background="@drawable/bg_home_tile" android:clickable="true" android:focusable="true"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true"
                        android:text="@string/home_series" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true"
                        android:text="@string/home_series_sub" android:textColor="#6B7280" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎞" android:textSize="30sp"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tileKids" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="14dp" android:background="@drawable/bg_home_tile" android:clickable="true" android:focusable="true"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true"
                        android:text="@string/home_kids" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true"
                        android:text="@string/home_kids_sub" android:textColor="#6B7280" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧒" android:textSize="30sp"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tileSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="14dp" android:background="@drawable/bg_home_tile" android:clickable="true" android:focusable="true"
                android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="16dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true"
                        android:text="@string/home_settings" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true"
                        android:text="@string/home_settings_sub" android:textColor="#6B7280" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️" android:textSize="30sp"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="14dp"
            android:background="@drawable/bg_home_bar" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end"
                android:text="@string/home_footer" android:textColor="#FFFFFF" android:textSize="13sp"/>
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/home_connecting" android:textColor="#DCE8FF" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <include android:id="@+id/overlay" layout="@layout/overlay_panel"/>
</FrameLayout>
