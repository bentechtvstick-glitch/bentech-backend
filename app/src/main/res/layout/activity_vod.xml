<?xml version="1.0" encoding="utf-8"?>
<!-- Films / Séries: kategori agoch, afich yo adwat (tankou TiviMate Premium) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="16dp">

        <LinearLayout android:layout_width="220dp" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:id="@+id/vodHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btnLive" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp"
                    android:layout_marginEnd="4dp" android:background="@drawable/bg_focus" android:text="@string/live_tv"
                    android:textAllCaps="false" android:textColor="@color/text" android:textSize="13sp"/>
                <Button android:id="@+id/btnSwitch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp"
                    android:background="@drawable/bg_focus" android:textAllCaps="false" android:textColor="@color/text" android:textSize="13sp"/>
            </LinearLayout>
            <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_input" android:hint="@string/vod_search_hint" android:importantForAutofill="no"
                android:imeOptions="actionSearch" android:inputType="text" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:singleLine="true" android:textColor="@color/text" android:textColorHint="@color/text_dim" android:textSize="15sp"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/categories" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:descendantFocusability="afterDescendants"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="16dp" android:orientation="vertical">
            <TextView android:id="@+id/gridTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:singleLine="true" android:ellipsize="end" android:textColor="@color/accent2" android:textSize="16sp" android:textStyle="bold"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="6dp" android:paddingBottom="24dp"
                    android:descendantFocusability="afterDescendants"/>
                <ProgressBar android:id="@+id/progress" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:visibility="gone"/>
                <TextView android:id="@+id/message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                    android:gravity="center" android:maxWidth="480dp" android:textColor="@color/text_dim" android:textSize="16sp" android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <include android:id="@+id/overlay" layout="@layout/overlay_panel"/>
</FrameLayout>
