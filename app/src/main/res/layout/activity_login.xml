<?xml version="1.0" encoding="utf-8"?>
<!-- Ekran aktivasyon: fon blan, logo nan mitan, MAC + Device Key, bouton ble won -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F5F9">

    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end"
        android:layout_marginTop="18dp" android:layout_marginEnd="28dp" android:format12Hour="h:mm a" android:format24Hour="HH:mm"
        android:textColor="#1A1F36" android:textSize="18sp" android:textStyle="bold"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="420dp" android:layout_height="wrap_content" android:layout_gravity="center"
            android:gravity="center" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="20dp">

            <!-- Logo Galaxy TV Stick -->
            <ImageView android:layout_width="300dp" android:layout_height="150dp" android:src="@drawable/logo_full"
                android:scaleType="fitCenter" android:contentDescription="@string/app_name"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/label_mac" android:textColor="#6B7280" android:textSize="13sp"/>
            <TextView android:id="@+id/macText" android:layout_width="280dp" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:background="@drawable/bg_id_box" android:fontFamily="monospace" android:gravity="center"
                android:paddingTop="9dp" android:paddingBottom="9dp" android:textColor="#1A1F36" android:textSize="22sp"
                android:textStyle="bold" android:textIsSelectable="false"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/label_device_key" android:textColor="#6B7280" android:textSize="13sp"/>
            <TextView android:id="@+id/keyText" android:layout_width="280dp" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:background="@drawable/bg_id_box" android:fontFamily="monospace" android:gravity="center" android:letterSpacing="0.2"
                android:paddingTop="9dp" android:paddingBottom="9dp" android:textColor="#1A1F36" android:textSize="22sp" android:textStyle="bold"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:gravity="center_vertical" android:orientation="horizontal">
                <ProgressBar android:id="@+id/progress" android:layout_width="24dp" android:layout_height="24dp" android:indeterminateTint="#2B32E6"/>
                <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="@string/waiting_playlist" android:textColor="#2B32E6" android:textSize="15sp"/>
            </LinearLayout>

            <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:textColor="#D32F2F" android:textSize="14sp" android:visibility="gone"/>

            <!-- Playlist panel la voye yo -->
            <LinearLayout android:id="@+id/playlistBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
                    android:text="@string/choose_playlist" android:textColor="#1A1F36" android:textSize="16sp" android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/playlists" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:descendantFocusability="afterDescendants"/>
            </LinearLayout>

            <!-- Fòm manyèl (sèlman si ALLOW_MANUAL_LOGIN = true) -->
            <LinearLayout android:id="@+id/manualBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="vertical" android:visibility="gone">
                <EditText android:id="@+id/server" style="@style/Galaxy.Input" android:hint="@string/hint_server" android:inputType="textUri" android:importantForAutofill="no"/>
                <EditText android:id="@+id/username" style="@style/Galaxy.Input" android:hint="@string/hint_username" android:inputType="text" android:importantForAutofill="no"/>
                <EditText android:id="@+id/password" style="@style/Galaxy.Input" android:hint="@string/hint_password" android:inputType="textPassword" android:imeOptions="actionDone" android:importantForAutofill="no"/>
                <Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill_button" android:text="@string/btn_login" android:textAllCaps="false"
                    android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
            </LinearLayout>

            <Button android:id="@+id/btnRefresh" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_button" android:text="@string/refresh_now" android:textAllCaps="false"
                android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>

            <TextView android:id="@+id/deviceInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center" android:textColor="#8A90A2" android:textSize="12sp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:text="@string/disclaimer"
                android:textColor="#6E7488" android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
