<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus_fill"/><stroke android:width="3dp" android:color="@color/accent2"/><corners android:radius="10dp"/></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#442A1F5C"/><stroke android:width="2dp" android:color="@color/accent"/><corners android:radius="10dp"/></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/accent"/><corners android:radius="10dp"/></shape>
    </item>
    <item>
        <shape><solid android:color="@color/bg_item"/><corners android:radius="10dp"/></shape>
    </item>
</selector>
